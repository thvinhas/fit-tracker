{
  "appId": "com.fittracker.app",
  "appName": "Fit Tracker",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#09090b",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#09090b",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#09090b",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "native",
      "style": "DARK"
    }
  }
}
